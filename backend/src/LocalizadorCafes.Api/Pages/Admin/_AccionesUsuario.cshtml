@model (Guid Id, string Name, bool IsAdmin, bool IsSuspended, bool IsSelf, string ReturnUrl)

@if (Model.IsSelf)
{
    <span class="suave pequeno">Tu cuenta</span>
}
else
{
    @if (!Model.IsAdmin)
    {
        <form method="post" asp-page="/Admin/Usuarios" asp-page-handler="Grant" data-confirmar="¿Dar permisos de administrador a @Model.Name?">
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="volver" value="@Model.ReturnUrl" />
            <button type="submit" class="boton secundario">Hacer admin</button>
        </form>
        @if (Model.IsSuspended)
        {
            <form method="post" asp-page="/Admin/Usuarios" asp-page-handler="Reactivate">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="volver" value="@Model.ReturnUrl" />
                <button type="submit" class="boton aprobar">Reactivar</button>
            </form>
        }
        else
        {
            <form method="post" asp-page="/Admin/Usuarios" asp-page-handler="Suspend" data-confirmar="¿Suspender la cuenta de @Model.Name? No podrá iniciar sesión ni publicar.">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="volver" value="@Model.ReturnUrl" />
                <button type="submit" class="boton secundario">Suspender</button>
            </form>
        }
        <form method="post" asp-page="/Admin/Usuarios" asp-page-handler="Delete" data-confirmar="¿Borrar la cuenta de @Model.Name? Su contenido se conservará sin vincular. No se puede deshacer.">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="boton rechazar">Borrar</button>
        </form>
    }
    else
    {
        <form method="post" asp-page="/Admin/Usuarios" asp-page-handler="Revoke" data-confirmar="¿Quitar los permisos de administrador a @Model.Name?">
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="volver" value="@Model.ReturnUrl" />
            <button type="submit" class="boton rechazar">Quitar admin</button>
        </form>
    }
}
