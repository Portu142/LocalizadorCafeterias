@page "/admin/resenas"
@model ResenasModel
@{
    ViewData["Title"] = "Reseñas";
}
<h1>Reseñas</h1>
<p class="suave">Las reseñas se publican al momento. Busca por texto, autor o cafetería y borra las inapropiadas (no se puede deshacer).</p>

<form method="get" class="buscador" role="search">
    <label for="q" class="oculto">Buscar reseñas</label>
    <input id="q" name="q" value="@Model.Query" type="search" placeholder="Buscar en el texto, autor o cafetería…" maxlength="100" />
    <button type="submit" class="boton secundario">Buscar</button>
    @if (!string.IsNullOrEmpty(Model.Query))
    {
        <a href="@Model.WithQuery("q", null)">Quitar búsqueda</a>
    }
</form>

<partial name="_ListaResenas" model="new ReviewListModel(Model.Result.Items, Model.CurrentUrl)" />
<partial name="_Paginacion" model="new PagerModel(Model.Result.Page, Model.Result.TotalPages, Model.Result.Total, Model.PageUrl)" />
