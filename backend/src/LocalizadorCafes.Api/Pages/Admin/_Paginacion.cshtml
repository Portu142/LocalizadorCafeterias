@model PagerModel

@if (Model.TotalPages > 1)
{
    <nav class="paginacion" aria-label="Paginación">
        @if (Model.Page > 1)
        {
            <a class="boton secundario" href="@Model.Url(Model.Page - 1)" rel="prev">← Anterior</a>
        }
        <span class="suave">Página @Model.Page de @Model.TotalPages · @Model.Total resultados</span>
        @if (Model.Page < Model.TotalPages)
        {
            <a class="boton secundario" href="@Model.Url(Model.Page + 1)" rel="next">Siguiente →</a>
        }
    </nav>
}
else if (Model.Total > 0)
{
    <p class="suave pequeno paginacion">@Model.Total resultados</p>
}
